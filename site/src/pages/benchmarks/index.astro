---
import Base from '../../layouts/Base.astro';
import { qualityData, sourceHost } from '../../lib/quality';

const { benchmarks, groups } = qualityData();

// How many models (base or quant) have a score for each benchmark.
const modelCount = new Map<string, number>();
for (const m of groups.flatMap((g) => [g.model, ...g.quants])) {
  for (const id of new Set(m.scores.map((s) => s.benchmarkId))) modelCount.set(id, (modelCount.get(id) ?? 0) + 1);
}

// Most-used benchmarks first, ties by name.
const listed = [...benchmarks.values()]
  .filter((b) => modelCount.has(b.id))
  .sort((a, b) => modelCount.get(b.id)! - modelCount.get(a.id)! || a.name.localeCompare(b.name));

// One chip per category, the biggest first.
const categoryCount = new Map<string, number>();
for (const b of listed) categoryCount.set(b.category, (categoryCount.get(b.category) ?? 0) + 1);
const categories = [...categoryCount].sort(([a, n], [b, m]) => m - n || a.localeCompare(b));
---

<Base
  title="Benchmarks"
  description="What each quality benchmark behind the published model scores measures, and where it comes from."
  current="benchmarks"
>
  <div class="wrap">
    <header class="page-head">
      <div class="kicker">Benchmarks</div>
      <h1>The benchmarks behind the scores</h1>
      <p>
        Every benchmark a publisher reported a score for. Open one to read what it measures, follow its
        source, and see every model's score on it.
      </p>
      <ul class="qstats">
        <li>{listed.length} benchmarks</li>
        <li>{categories.length} categories</li>
      </ul>
    </header>

    <form class="qfilters" id="bench-filters" role="search" hidden>
      <label class="qfilter qfilter-search">
        <span class="label">Search</span>
        <input
          type="search"
          name="q"
          placeholder="Name or topic: swe-bench, math, long context"
          autocomplete="off"
          spellcheck="false"
        />
      </label>
      <div class="qfilter-status">
        <span id="bench-count" aria-live="polite"></span>
        <button type="reset" class="qfilter-clear" hidden>Clear</button>
      </div>
      <fieldset class="qchips">
        <legend class="label">Category</legend>
        {
          categories.map(([c, n]) => (
            <label class="qchip">
              <input type="checkbox" name="category" value={c} />
              <span>
                {c} <span class="qchip-n">{n}</span>
              </span>
            </label>
          ))
        }
      </fieldset>
    </form>

    <div class="qtable-scroll">
      <table class="qtable" id="bench-table">
        <thead>
          <tr>
            <th scope="col" data-sort="name">
              <button type="button" class="sort">Benchmark</button>
            </th>
            <th scope="col">Category</th>
            <th scope="col" class="num" data-sort="models" aria-sort="descending">
              <button type="button" class="sort">Models</button>
            </th>
            <th scope="col">Source</th>
          </tr>
        </thead>
        <tbody>
          {
            listed.map((b) => (
              <tr
                data-name={b.name.toLowerCase()}
                data-category={b.category}
                data-models={modelCount.get(b.id)}
                data-search={[b.name, b.id, b.category].join(' ')}
                data-desc={b.description.toLowerCase()}
              >
                <th scope="row">
                  <a href={`/benchmarks/${b.slug}/`}>{b.name}</a>
                </th>
                <td class="bench-category">{b.category}</td>
                <td class="num">{modelCount.get(b.id)}</td>
                <td class="mono">
                  {b.sourceUrl ? <a href={b.sourceUrl}>{sourceHost(b.sourceUrl)} ↗</a> : <span class="none">—</span>}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="qtable-empty" id="bench-empty" hidden>No benchmark matches these filters.</p>
    <p class="qtable-note">
      Models: how many models and quantized builds have a published score for it. Search also looks in
      each benchmark's description.
    </p>
  </div>
</Base>

<script>
  import { flat, matches, text } from '../../lib/fuzzy';

  const table = document.getElementById('bench-table');
  const body = table?.querySelector('tbody');
  const rows = [...(body?.querySelectorAll<HTMLTableRowElement>('tr') ?? [])];
  const form = document.getElementById('bench-filters') as HTMLFormElement | null;
  const count = document.getElementById('bench-count');
  const empty = document.getElementById('bench-empty');
  const clear = form?.querySelector<HTMLButtonElement>('.qfilter-clear');

  const index = rows.map((row) => ({
    row,
    search: text(row.dataset.search ?? ''),
    desc: row.dataset.desc ?? '',
    category: row.dataset.category ?? '',
  }));

  // Every word typed must match the name, id or category (with one typo
  // allowed), or appear in the description. Ticked chips keep only their
  // categories; none ticked keeps every category.
  function apply() {
    if (!form) return;
    const data = new FormData(form);
    const raw = String(data.get('q') ?? '').toLowerCase().split(/\s+/).filter(Boolean);
    const cats = new Set(data.getAll('category').map(String));
    let shown = 0;
    for (const b of index) {
      const ok =
        (cats.size === 0 || cats.has(b.category)) &&
        raw.every((word) => {
          const term = flat(word);
          return term === '' || matches(term, b.search) || b.desc.includes(word);
        });
      b.row.hidden = !ok;
      if (ok) shown++;
    }
    const active = raw.length > 0 || cats.size > 0;
    if (count) count.textContent = active ? `${shown} of ${index.length} benchmarks` : `${index.length} benchmarks`;
    if (empty) empty.hidden = shown > 0;
    if (clear) clear.hidden = !active;
  }

  if (form) {
    form.hidden = false;
    form.addEventListener('input', apply);
    form.addEventListener('submit', (e) => e.preventDefault());
    form.addEventListener('reset', () => setTimeout(apply)); // fields reset after the event
    apply();
  }

  // Sorting: names A to Z and model counts high to low on the first click; a
  // second click reverses. Ties fall back to the name.
  const headers = [...(table?.querySelectorAll<HTMLElement>('th[data-sort]') ?? [])];
  headers.forEach((th) =>
    th.querySelector('button')?.addEventListener('click', () => {
      if (!body) return;
      const isName = th.dataset.sort === 'name';
      const current = th.getAttribute('aria-sort');
      const dir = current === 'ascending' ? -1 : current === 'descending' ? 1 : isName ? 1 : -1;
      const name = (r: HTMLElement) => r.dataset.name ?? '';
      const models = (r: HTMLElement) => Number(r.dataset.models);
      rows.sort((a, b) =>
        isName
          ? name(a).localeCompare(name(b)) * dir
          : (models(a) - models(b)) * dir || name(a).localeCompare(name(b)),
      );
      body.append(...rows);
      headers.forEach((h) => h.removeAttribute('aria-sort'));
      th.setAttribute('aria-sort', dir === 1 ? 'ascending' : 'descending');
    }),
  );
</script>
