---
import Base from '../../layouts/Base.astro';
import { allArticles, bySetup, setupSlug } from '../../lib/articles';

const setups = bySetup(await allArticles());
---

<Base
  title="Setups"
  description="Benchmarks grouped by hardware setup: every model measured on the same box."
  current="setups"
>
  <div class="wrap">
    <header class="page-head">
      <div class="kicker">Setups</div>
      <h1>One series per hardware setup</h1>
      <p>Within a setup the hardware never changes, so every model compares with the others.</p>
    </header>
    {
      setups.size === 0 ? (
        <p class="label" style="padding: 40px 0">No setups yet.</p>
      ) : (
        <div class="family-grid">
          {[...setups].map(([name, articles]) => (
            <a href={`/setups/${setupSlug(name)}/`}>
              <strong>{name}</strong>
              <span class="label">
                {articles.length} article{articles.length === 1 ? '' : 's'}
              </span>
            </a>
          ))}
        </div>
      )
    }
  </div>
</Base>
